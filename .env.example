# Morning Aroma — Environment Variables (production backend reference)
#
# This prototype's frontend runs entirely in-memory and needs NONE of these to work —
# `npm install && npm run dev` is genuinely all it takes. This file documents what a real
# backend build (Next.js API routes + Postgres + Redis + NextAuth + Stripe + a CMS, per the
# original project brief) would need. Copy to `.env.local` once that backend exists;
# never commit the real filled-in version to git.

# --- Database (PostgreSQL, e.g. via Prisma — see prisma/schema.prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/morning_aroma"

# --- Redis (OTP codes, session cache, recommendation cache) ---
REDIS_URL="redis://localhost:6379"

# --- NextAuth.js ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-here"

# --- Google OAuth (for "Continue with Google") ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (for OTP delivery) ---
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Morning Aroma <no-reply@morningaroma.com>"

# --- Stripe (checkout / payments) ---
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- CMS (Strapi or Sanity — pick one, per the original brief) ---
CMS_API_URL=""
CMS_API_TOKEN=""

# --- Media storage (Cloudinary or S3/CloudFront) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# — or —
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# --- App-level ---
NODE_ENV="development"
