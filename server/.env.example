# Copy to .env for local development. On Railway, set these as actual service environment
# variables instead — never commit a real .env file (already covered by the repo's .gitignore).

# Provided automatically if you provision Postgres as a Railway service in the same project;
# otherwise the full connection string for whatever Postgres instance you're using.
DATABASE_URL=postgresql://user:password@localhost:5432/morning_aroma

# Must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this across environments (dev/staging/production should each have their own), and
# never commit the real value.
JWT_SECRET=

# The deployed frontend's actual URL, so the API's CORS policy allows it to make requests.
# Example: https://morning-aroma-app-production.up.railway.app
FRONTEND_URL=

# From your Paystack dashboard: Settings > API Keys & Webhook. Use the sk_test_... key while
# testing, switch to sk_live_... only once real payments are actually ready to go live. This is
# the SECRET key — never expose it to the frontend or commit the real value. (The public key,
# pk_test_.../pk_live_..., is safe to expose and belongs on the frontend service instead, as
# VITE_PAYSTACK_PUBLIC_KEY — see the root .env.example.)
# Also used to verify the HMAC signature on incoming webhooks (POST /webhooks/paystack) —
# Paystack signs webhooks with this same secret key, not a separate "webhook secret". See
# server/README.md for the dashboard steps to actually register the webhook URL.
PAYSTACK_SECRET_KEY=

# From your Resend dashboard: API Keys > Create API Key (Sending access is enough, not Full
# access). Without this set, welcome/password-reset emails fall back to logging to the console
# instead of sending — safe for local development, but means production needs this set or those
# emails silently never go out. Real delivery to arbitrary customers (not just your own Resend
# account email) requires a verified domain too — see EMAIL_FROM_ADDRESS below.
RESEND_API_KEY=

# Optional. Defaults to "Morning Aroma <onboarding@resend.dev>" if unset — Resend's own shared
# testing address, which can only deliver to your own Resend account's registered email until a
# domain is verified. Once you verify a real domain with Resend, set this to an address on it,
# e.g. "Morning Aroma <no-reply@morningaroma.com>", to actually reach real customers.
EMAIL_FROM_ADDRESS=

# Railway sets this automatically — only needed here for running locally.
PORT=4000

NODE_ENV=development
