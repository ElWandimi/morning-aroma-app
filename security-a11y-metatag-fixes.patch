+  if (!mimeMatch || !ALLOWED_IMAGE_TYPES.includes(mimeMatch[1])) {
+    throw new Error(`Unsupported image type. Please use JPEG, PNG, WebP, or GIF.`);
+  }
   return uploadImage(photoUrl, folder);
 }
 
